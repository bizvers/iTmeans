---
import type { Word } from "../lib/content";
import { text, flow, refOf } from "../lib/content";
import { tr } from "../lib/ui";
interface Props { word: Word; lang: string; full?: boolean; domainNotice?: boolean }
const { word: w, lang, full = false, domainNotice = false } = Astro.props;
const related = w.related.map((id) => refOf(id)).filter((r) => !!r); // ids that exist (the build check guarantees all do)
const H = full ? "h1" : "h2";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const fmt = (d: string | null) => d ?? "—";
---
<article class:list={["poster", { full }]}>
  <div class="p-head">
    <span class:list={["lv", w.level]}>{tr(lang, w.level)}</span>
    <H data-pagefind-weight="10">{w.term}</H>
    <span class="pr">{tr(lang, "pron")}: {w.pronunciation_hi}{w.term_hi ? ` · ${w.term_hi}` : ""}</span>
  </div>
  <div class="p-body">
    {domainNotice && <p class="notice">{tr(lang, "notAdvice")}</p>}
    <div>
      <div class="p-lab">{tr(lang, "glance")}</div>
      <ol class="flow">{flow(w, lang).map((s) => <li>{s}</li>)}</ol>
    </div>
    <div class="tbl">
      <div class="k">{tr(lang, "literal")}</div><div>{text(w, "literal_meaning", lang)}</div>
      <div class="k">{tr(lang, "fieldMeaning")}</div><div>{text(w, "field_meaning", lang)}</div>
      <div class="k">{tr(lang, "effect")}</div><div>{text(w, "effect", lang)}</div>
      <div class="k">{tr(lang, "usage")}</div><div>{text(w, "usage", lang)}</div>
      <div class="k">{tr(lang, "example")}</div><div>{text(w, "example", lang)}</div>
      <div class="k caut">{tr(lang, "caution")}</div><div class="caut">{text(w, "caution", lang)}</div>
    </div>
    {related.length > 0 && (
      <div>
        <div class="p-lab">{tr(lang, "related")}</div>
        <div class="tags">
          {related.map((r) => r!.slug
            ? <a class="tag" href={`${base}/${lang}/${r!.domain}/${r!.subtopic}/${r!.slug}/`}>{r!.term}</a>
            : <span class="tag plain">{r!.term}</span>)}
        </div>
      </div>
    )}
  </div>
  <div class="p-foot">
    <span>
      {w.written_by ? `${tr(lang, "written")}: ${w.written_by} · ${tr(lang, "checked")}: ${w.checked_by.join(", ")}` : tr(lang, "pending")}
      · {tr(lang, "date")}: {fmt(w.checked_at ?? w.created_at)}
    </span>
    <a class="report" href="https://github.com/" rel="noopener">{tr(lang, "report")}</a>
  </div>
</article>
