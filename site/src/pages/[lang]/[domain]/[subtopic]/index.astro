---
import Dict from "../../../../layouts/Dict.astro";
import { languages, domains, wordsOf, nameIn, text } from "../../../../lib/content";
import { tr, LETTERS } from "../../../../lib/ui";
export function getStaticPaths() {
  return languages.flatMap((l) => domains.flatMap((d) => d.subtopics.map((s) => ({ params: { lang: l.code, domain: d.id, subtopic: s.id } }))));
}
const { lang, domain, subtopic } = Astro.params as Record<string, string>;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const d = domains.find((x) => x.id === domain)!;
const s = d.subtopics.find((x) => x.id === subtopic)!;
const words = wordsOf(domain, subtopic);
const letters = LETTERS.filter((L) => words.some((w) => w.letter === L));
const chapters = letters.map((L, k) => ({ L, items: words.filter((w) => w.letter === L), prev: letters[k - 1], next: letters[k + 1] }));
const first = (w: (typeof words)[number]) => text(w, "field_meaning", lang).split(/[।.]/)[0];
const title = `${nameIn(s, lang)} · ${nameIn(d, lang)} — iTmeans`;
---
<Dict lang={lang} title={title} rest={`${domain}/${subtopic}/`} domain={domain} subtopic={subtopic} inPage>
  <div class="crumb"><a href={`${base}/${lang}/${domain}/`}>{nameIn(d, lang)}</a> › {nameIn(s, lang)}</div>
  {d.notice && <p class="notice" style="margin-top:10px">{tr(lang, "notAdvice")}</p>}
  {chapters.length === 0 ? (
    <h1 style="margin-top:8px">{nameIn(s, lang)}</h1>
    <p class="empty">{tr(lang, "emptySub")}</p>
  ) : chapters.map(({ L, items, prev, next }) => (
    <section class="chap" id={L} data-letter={L}>
      <div class="ch"><h1>{tr(lang, "chapter")} {L}</h1><small>{items.length} {tr(lang, items.length === 1 ? "word1" : "words")}</small></div>
      <div class="rows">
        {items.map((w) => (
          <a class="w" href={`${base}/${lang}/${domain}/${subtopic}/${w.slug}/`}>
            <b>{w.term}<i>/ {w.pronunciation_hi} /</i></b>
            <p>{first(w)}।</p>
            <span class="lv">{tr(lang, w.level)}</span>
          </a>
        ))}
      </div>
      <div class="nav">
        {prev ? <a class="btn" href={`#${prev}`} data-l={prev}>❮ {tr(lang, "prevChapter")}: {prev}</a> : <span></span>}
        {next ? <a class="btn p" href={`#${next}`} data-l={next}>{tr(lang, "nextChapter")}: {next} ❯</a> : <span></span>}
      </div>
    </section>
  ))}
  <script>
    // one chapter (letter) at a time; without JavaScript every chapter is simply listed one under the other
    const secs = [...document.querySelectorAll<HTMLElement>(".chap")];
    const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-l]")];
    const letters = secs.map((s) => s.dataset.letter!);
    function show(l: string, push = false) {
      secs.forEach((s) => (s.hidden = s.dataset.letter !== l));
      document.querySelectorAll<HTMLAnchorElement>("#chapters a").forEach((a) => a.classList.toggle("on", a.dataset.l === l));
      if (push) history.replaceState(null, "", `#${l}`);
    }
    if (secs.length) {
      const want = decodeURIComponent(location.hash.slice(1)).toUpperCase();
      show(letters.includes(want) ? want : letters[0]);
      links.forEach((a) => a.addEventListener("click", (e) => { e.preventDefault(); show(a.dataset.l!, true); window.scrollTo({ top: 0 }); }));
      window.addEventListener("hashchange", () => { const h = location.hash.slice(1).toUpperCase(); if (letters.includes(h)) show(h); });
    }
  </script>
</Dict>
