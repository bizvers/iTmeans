---
import Base from "../../layouts/Base.astro";
import { languages, domains, wordsOf, allWords, nameIn } from "../../lib/content";
import { tr } from "../../lib/ui";
export function getStaticPaths() { return languages.map((l) => ({ params: { lang: l.code } })); }
const { lang } = Astro.params as { lang: string };
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Base lang={lang} title={`iTmeans — ${tr(lang, "tagline")}`} rest="" description={tr(lang, "heroSub")} count={allWords().length}>
  <div class="home">
    <h1>{tr(lang, "heroTitle")}</h1>
    <p>{tr(lang, "heroSub")}</p>
    {domains.map((d) => (
      <section class="srow">
        <h2><a href={`${base}/${lang}/${d.id}/`}>{nameIn(d, lang)}</a></h2>
        <div class="chips">
          {d.subtopics.map((s) => (
            <a class="chip" href={`${base}/${lang}/${d.id}/${s.id}/`}>{nameIn(s, lang)}<small>{wordsOf(d.id, s.id).length}</small></a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
