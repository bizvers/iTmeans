---
// Admin page ("Basecamp"): site view, cycle settings, automation, subjects/languages on-off, reports from readers.
// Works only for accounts listed in Firestore admins/<uid>. One panel is shown at a time; the control buttons switch panels.
import fs from "node:fs";
import path from "node:path";
import Base from "../../../layouts/Base.astro";
import { languages as activeLanguages } from "../../../lib/content";
import { tr, REPO_URL } from "../../../lib/ui";
export function getStaticPaths() { return activeLanguages.map((l) => ({ params: { lang: l.code } })); }
const { lang } = Astro.params as { lang: string };
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ROOT = path.resolve(process.cwd(), "..", "content");
const read = (f: string) => JSON.parse(fs.readFileSync(path.join(ROOT, f), "utf8").replace(/^﻿/, ""));
const tax = read("taxonomy/taxonomy.json"), settings = read("settings/settings.json");
const readOr = (f: string, fallback: any) => { try { return read(f); } catch { return fallback; } };
const progress = { done_topics: [], exhausted: {}, review_job: null, total_published: 0, ...readOr("settings/progress.json", {}) };
const suggestions = readOr("settings/suggestions.json", []);
// words of every topic as of this build, and the topic being filled now (same rule as the cycle: agent/cycle/topic.mjs)
const countIn = (d: string, s: string) => { const dir = path.join(ROOT, "words", d, s); return fs.existsSync(dir) ? fs.readdirSync(dir).filter((f) => f.endsWith(".json")).length : 0; };
const topics = tax.domains.flatMap((d: any) => (d.subtopics ?? []).map((s: any) => ({ key: `${d.id}/${s.id}`, domain: d.id, id: s.id, en: s.en, hi: s.hi, words: countIn(d.id, s.id), done: progress.done_topics.includes(`${d.id}/${s.id}`) })));
const nowKey = (settings.current_topic && topics.find((x: any) => x.key === settings.current_topic && !x.done && tax.domains.find((d: any) => d.id === x.domain)?.active)?.key)
  ?? tax.domains.filter((d: any) => d.active).sort((a: any, b: any) => (a.order ?? 0) - (b.order ?? 0)).flatMap((d: any) => (d.subtopics ?? []).map((s: any) => `${d.id}/${s.id}`)).find((k: string) => !progress.done_topics.includes(k)) ?? null;
// current values as of this build (the saved admin settings, when present, win in the browser)
const data = {
  base: `${base}/${lang}/`,
  topics, nowKey, suggestions, progress: { total: progress.total_published, review: !!progress.review_job },
  settings: { stop_all: !!settings.stop_all, no_daily_cap: !!settings.no_daily_cap, pause_if_held_percent: settings.pause_if_held_percent, checker_pass_score: settings.checker_pass_score, backtranslation_pass_score: settings.backtranslation_pass_score, daily_caps: settings.daily_caps,
    topic_defaults: { min: 5, max: 20, review_every: 1000, popular_target: 100, ...(settings.topic_defaults ?? {}) }, topic_rules: settings.topic_rules ?? {}, current_topic: settings.current_topic ?? "" },
  domains: tax.domains.map((d: any) => ({ id: d.id, en: d.en, hi: d.hi, name: lang === "en" ? d.en : d.hi, active: !!d.active,
    subtopics: (d.subtopics ?? []).map((s: any) => ({ id: s.id, en: s.en, hi: s.hi })) })),
  lang,
  languages: tax.languages.map((l: any) => ({ code: l.code, name: `${l.native} (${l.en})`, active: !!l.active, fixed: l.code === "hi" || l.code === "en" })),
};
// ---- "AI work" panel: which model of which company did how much (from the ledger and the word files, as of this build)
const models: any[] = (() => { try { return JSON.parse(fs.readFileSync(path.resolve(process.cwd(), "..", "config", "models.json"), "utf8").replace(/^﻿/, "")).models; } catch { return []; } })();
const ledgerDir = path.join(ROOT, "ledger");
const ledgerFiles = fs.existsSync(ledgerDir) ? fs.readdirSync(ledgerDir).filter((f) => /^\d{4}-\d{2}-\d{2}\.jsonl$/.test(f)).sort() : [];
const readLedger = (f: string) => fs.readFileSync(path.join(ledgerDir, f), "utf8").split("\n").filter(Boolean).flatMap((l) => { try { return [JSON.parse(l)]; } catch { return []; } });
const lastDay = ledgerFiles.at(-1)?.slice(0, 10) ?? null;
const week = ledgerFiles.slice(-7).flatMap(readLedger);
const todayLed = lastDay ? week.filter((e: any) => String(e.t ?? "").startsWith(lastDay)) : [];
const keyOf = (e: any) => `${e.service}/${e.model}`;
const tally = (list: any[]) => { const m: Record<string, any> = {}; for (const e of list.filter((x) => x.kind === "call")) { const r = (m[keyOf(e)] ??= { all: 0, writer: 0, checker: 0, list: 0 }); r.all++; r[e.role] = (r[e.role] ?? 0) + 1; } return m; };
const callsToday = tally(todayLed), calls7 = tally(week);
const written: Record<string, number> = {}, checked: Record<string, number> = {};
let totalWords = 0;
const wordsDir = path.join(ROOT, "words");
const walk = (dir: string) => { if (!fs.existsSync(dir)) return; for (const f of fs.readdirSync(dir, { withFileTypes: true })) {
  const p = path.join(dir, f.name);
  if (f.isDirectory()) walk(p);
  else if (f.name.endsWith(".json")) { try { const w = JSON.parse(fs.readFileSync(p, "utf8").replace(/^﻿/, "")); if (w.status !== "published") continue; totalWords++;
    if (w.written_by) written[w.written_by] = (written[w.written_by] ?? 0) + 1;
    for (const c of w.checked_by ?? []) checked[c] = (checked[c] ?? 0) + 1; } catch { /* a broken file is reported by the content check */ } }
} };
walk(wordsDir);
const wordsToday = todayLed.filter((e: any) => e.kind === "word");
const outcome = (o: string) => wordsToday.filter((e: any) => e.outcome === o).length;
const whyHeld: Record<string, number> = {};
for (const e of wordsToday.filter((x: any) => x.outcome !== "published" && x.reason)) { const k = String(e.reason).split(/[;:|]/)[0].trim().slice(0, 60); whyHeld[k] = (whyHeld[k] ?? 0) + 1; }
const lastRun = [...todayLed].reverse().find((e: any) => e.t)?.t ?? null;
const notes = week.filter((e: any) => ["skip", "limits", "error", "paused"].includes(e.kind)).slice(-5).reverse();
const companies = [...new Set(models.map((m) => m.company))].map((company) => {
  const rows = models.filter((m) => m.company === company).map((m) => {
    const k = `${m.service}/${m.model}`, today = callsToday[k] ?? { all: 0, writer: 0, checker: 0, list: 0 };
    return { service: m.service, model: m.model, limit: m.daily_limit ?? null, today, week: calls7[k]?.all ?? 0, written: written[k] ?? 0, checked: checked[k] ?? 0,
      pct: m.daily_limit ? Math.min(100, Math.round((today.all * 100) / m.daily_limit)) : 0 };
  });
  return { company, rows, today: rows.reduce((s, r) => s + r.today.all, 0), written: rows.reduce((s, r) => s + r.written, 0), checked: rows.reduce((s, r) => s + r.checked, 0) };
});
const otherWriters = Object.entries(written).filter(([k]) => !models.some((m) => `${m.service}/${m.model}` === k)); // e.g. Claude, contributors, older models

const t = (k: string) => tr(lang, k);
const home = `${base}/${lang}/`;
const controls = [
  { id: "site", icon: "◉", label: t("ctlSite") },
  { id: "cycle", icon: "↻", label: t("ctlCycle") },
  { id: "work", icon: "≡", label: t("ctlWork") },
  { id: "subjects", icon: "☰", label: t("ctlSubjects") },
  { id: "languages", icon: "अ", label: t("ctlLanguages") },
  { id: "auto", icon: "▶", label: t("ctlAuto") },
  { id: "reports", icon: "!", label: t("ctlReports") },
];
// GitHub Actions workflows (.github/workflows). "Run" opens the workflow page, where GitHub's own "Run workflow" button starts it.
const jobs = [
  { file: "hourly-cycle.yml", title: t("autoCycle"), desc: t("autoCycleDesc") },
  { file: "daily-merge.yml", title: t("autoMerge"), desc: t("autoMergeDesc") },
  { file: "deploy.yml", title: t("autoDeploy"), desc: t("autoDeployDesc") },
];
---
<Base lang={lang} title={`${t("basecampWelcome")} — iTmeans`} rest="admin/" bare>
  <div class="home adm" id="adm" data-saved={t("settingsSaved")} data-i18n={JSON.stringify({
    on: t("tagOn"), off: t("tagOff"), pending: t("tagPending"), rename: t("renameBtn"), ok: t("okBtn"), addSub: t("addSubBtn"), add: t("addBtn"),
    nameHi: t("nameHi"), nameEn: t("nameEn"), errNames: t("errNames"), errExists: t("errExists"), errReserved: t("errReserved"),
    errEnglish: t("errEnglish"), added: t("addedRemindSave"), needSub: t("needSubtopic"),
    ruleNone: t("ruleNone"), rulePopular: t("rulePopular"), ruleLetters: t("ruleLetters"), ruleTarget: t("ruleTarget"), ruleRemove: t("ruleRemove"),
    workAuto: t("workAuto"), topicNone: t("topicNone"), topicWords: t("topicWords"), approveBtn: t("approveBtn"), approvedRemind: t("approvedRemind") })} data-resumed={t("resumeSent")} data-failed={t("saveFailed")} data-new={t("statusNew")} data-done={t("statusDone")} data-markdone={t("markDone")} data-error={t("errorTry")}>
    <h1>{t("basecampWelcome")}</h1>
    {lang !== "en" && <p class="bc-en">Welcome to Basecamp</p>}
    <p id="adm-loading">{t("loading")}</p>
    <div id="adm-out" hidden><p>{t("adminPleaseSignIn")}</p><button type="button" class="btn p" data-open-signin>{t("signIn")}</button></div>
    <div id="adm-no" hidden><p>{t("adminNotAllowed")}</p></div>
    <div id="adm-in" hidden>
      <p class="hint bc-sub">{t("basecampSub")}</p>
      <div class="ctl" role="tablist" aria-label={t("adminTitle")}>
        {controls.map((c, i) => (
          <button type="button" role="tab" id={`tab-${c.id}`} data-panel={c.id} aria-controls={`p-${c.id}`} aria-selected={i === 0 ? "true" : "false"}>
            <span class="ic" aria-hidden="true">{c.icon}</span>{c.label}{c.id === "reports" && <span class="badge" id="r-count" hidden></span>}
          </button>
        ))}
      </div>

      <section id="p-site" class="panel" role="tabpanel" aria-labelledby="tab-site">
        <div class="row tight">
          <div class="seg" role="group">
            <button type="button" class="btn" data-view="desk" aria-pressed="true">{t("viewDesktop")}</button>
            <button type="button" class="btn" data-view="mob" aria-pressed="false">{t("viewMobile")}</button>
          </div>
          <a class="btn" href={home} target="_blank" rel="noopener">{t("openNewTab")} ↗</a>
        </div>
        <p class="hint">{t("siteViewHint")}</p>
        <div class="frame" id="site-frame"><iframe title={t("ctlSite")} data-src={home} loading="lazy"></iframe></div>
      </section>

      <section id="p-cycle" class="panel" role="tabpanel" aria-labelledby="tab-cycle" hidden>
        <p class="hint intro">{t("cycleIntro")}</p>
        <div class="set">
          <label class="chk"><input type="checkbox" id="f-stop" /> <b>{t("stopAll")}</b></label>
          <p class="desc">{t("stopAllDesc")}</p>
        </div>
        <div class="set">
          <label class="chk"><input type="checkbox" id="f-nocap" /> <b>{t("noCap")}</b></label>
          <p class="desc">{t("noCapDesc")}</p>
        </div>
        <div class="set">
          <b>{t("dailyCap")}</b>
          <p class="desc">{t("dailyCapDesc")}</p>
          <div id="f-caps" class="grid2"></div>
        </div>
        <div class="set">
          <label class="num">{t("pausePct")}<input type="number" id="f-pct" min="1" max="100" /></label>
          <p class="desc">{t("pausePctDesc")}</p>
        </div>
        <div class="set">
          <label class="num">{t("checkerScore")}<input type="number" id="f-chk" min="0" max="100" /></label>
          <p class="desc">{t("checkerScoreDesc")}</p>
        </div>
        <div class="set">
          <label class="num">{t("backScore")}<input type="number" id="f-bt" min="0" max="100" /></label>
          <p class="desc">{t("backScoreDesc")}</p>
        </div>
        <div class="set">
          <div class="row tight"><button type="button" class="btn p f-save">{t("saveSettings")}</button><span class="f-msg" role="status"></span></div>
          <p class="desc">{t("saveDesc")}</p>
        </div>
        <div class="set">
          <div class="row tight"><button type="button" class="btn" id="f-resume">{t("resumeCycle")}</button></div>
          <p class="desc">{t("resumeDesc")}</p>
        </div>
      </section>

      <section id="p-subjects" class="panel" role="tabpanel" aria-labelledby="tab-subjects" hidden>
        <h2>{t("subjectsOnOff")}</h2>
        <p class="hint intro">{t("subjectsIntro")}</p>
        <div id="f-domains" class="doms"></div>
        <div class="dom newdom">
          <b>{t("addDomain")}</b>
          <div class="addrow">
            <label>{t("nameHi")}<input id="nd-hi" maxlength="60" /></label>
            <label>{t("nameEn")}<input id="nd-en" maxlength="60" /></label>
          </div>
          <div class="addrow">
            <label>{t("firstSubHi")}<input id="nd-shi" maxlength="60" /></label>
            <label>{t("firstSubEn")}<input id="nd-sen" maxlength="60" /></label>
            <button type="button" class="btn" id="nd-add">{t("addBtn")}</button>
          </div>
          <p class="desc" id="nd-msg" role="status">{t("addDomainDesc")}</p>
        </div>
        <p class="hint">{t("noDeleteNote")}</p>
        <h2>{t("ctlTopics")}</h2>
        <p class="hint intro">{t("topicsIntro")}</p>
        <div class="set">
          <b>{t("topicNow")}</b>
          <p class="desc" id="tp-now"></p>
          <p class="desc" id="tp-review" hidden>{t("topicReview")}</p>
          <p class="desc">{t("topicMilestone")}: <b id="tp-total"></b></p>
        </div>
        <div class="set">
          <b>{t("defaultsTitle")}</b>
          <div class="grid2">
            <label class="num">{t("minLetter")}<input type="number" id="f-tmin" min="0" max="100" /></label>
            <label class="num">{t("maxLetter")}<input type="number" id="f-tmax" min="1" max="100" /></label>
            <label class="num">{t("reviewEvery")}<input type="number" id="f-trev" min="10" max="100000" /></label>
          </div>
          <p class="desc">{t("defaultsDesc")}</p>
        </div>
        <div class="set">
          <label class="num">{t("workNow")}<select id="f-current"></select></label>
        </div>
        <div class="set">
          <b>{t("ruleTitle")}</b>
          <p class="desc">{t("ruleDesc")}</p>
          <div class="addrow">
            <select id="rl-topic" aria-label={t("ruleTitle")}></select>
            <select id="rl-mode"><option value="letters">{t("ruleLetters")}</option><option value="popular">{t("rulePopular")}</option></select>
          </div>
          <div class="addrow">
            <label class="num">{t("minLetter")}<input type="number" id="rl-min" min="0" max="100" /></label>
            <label class="num">{t("maxLetter")}<input type="number" id="rl-max" min="1" max="100" /></label>
            <label class="num">{t("ruleTarget")}<input type="number" id="rl-target" min="1" max="5000" /></label>
            <button type="button" class="btn" id="rl-add">{t("ruleSet")}</button>
          </div>
          <div id="rl-list"></div>
        </div>
        <div class="set">
          <b>{t("suggestTitle")}</b>
          <p class="desc" id="sg-none" hidden>{t("suggestNone")}</p>
          <div id="sg-list"></div>
        </div>
        <div class="set">
          <div class="row tight"><button type="button" class="btn p f-save">{t("saveSettings")}</button><span class="f-msg" role="status"></span></div>
        </div>
      </section>

      <section id="p-work" class="panel" role="tabpanel" aria-labelledby="tab-work" hidden>
        <h2>{t("workTitle")}</h2>
        <p class="hint">{t("workIntro")}</p>
        {!lastDay ? <p class="empty">{t("workNoData")}</p> : (
          <>
            <div class="wk-cards">
              <div><span>{t("workTotalWords")}</span><b>{totalWords}</b></div>
              <div><span>{t("workPublished")} ({lastDay})</span><b>{outcome("published")}</b></div>
              <div><span>{t("workRetry")}</span><b>{outcome("retry")}</b></div>
              <div><span>{t("workHeld")}</span><b>{outcome("held")}</b></div>
              <div><span>{t("workLastRun")}</span><b class="sm">{lastRun ? lastRun.slice(0, 16).replace("T", " ") + " UTC" : "—"}</b></div>
            </div>
            <div class="wk-wrap">
              <table class="wk">
                <thead><tr>
                  <th>{t("workModel")}</th><th>{t("workCallsToday")}</th><th>{t("workRoles")}</th><th>{t("workCalls7")}</th><th>{t("workWritten")}</th><th>{t("workChecked")}</th>
                </tr></thead>
                {companies.map((c) => (
                  <tbody>
                    <tr class="co"><th colspan="6">{c.company} <span>· {t("workCallsToday")}: {c.today} · {t("workWritten")}: {c.written} · {t("workChecked")}: {c.checked}</span></th></tr>
                    {c.rows.map((r) => (
                      <tr class={r.today.all ? "" : "idle"}>
                        <td><b>{r.model}</b><small>{r.service}</small></td>
                        <td><span class="bar" title={`${r.pct}%`}><i style={`width:${r.pct}%`}></i></span>{r.today.all} / {r.limit ?? "—"}</td>
                        <td>{r.today.writer} / {r.today.checker} / {r.today.list}</td>
                        <td>{r.week}</td><td>{r.written}</td><td>{r.checked}</td>
                      </tr>
                    ))}
                  </tbody>
                ))}
                {otherWriters.length > 0 && (
                  <tbody>
                    <tr class="co"><th colspan="6">{t("workOthers")}</th></tr>
                    {otherWriters.map(([k, n]) => (<tr class="idle"><td><b>{k}</b></td><td>—</td><td>—</td><td>—</td><td>{n}</td><td>{checked[k] ?? 0}</td></tr>))}
                  </tbody>
                )}
              </table>
            </div>
            {Object.keys(whyHeld).length > 0 && (<>
              <h3>{t("workHeldWhy")} ({lastDay})</h3>
              <ul class="wk-list">{Object.entries(whyHeld).sort((a, b) => b[1] - a[1]).map(([k, n]) => <li><b>{n}</b> {k}</li>)}</ul>
            </>)}
            {notes.length > 0 && (<>
              <h3>{t("workNotes")}</h3>
              <ul class="wk-list">{notes.map((e: any) => <li><small>{String(e.t ?? "").slice(0, 16).replace("T", " ")}</small> <b>{e.kind}</b> {String(e.reason ?? e.message ?? "").slice(0, 140)}</li>)}</ul>
            </>)}
          </>
        )}
      </section>

      <section id="p-auto" class="panel" role="tabpanel" aria-labelledby="tab-auto" hidden>
        <p class="hint intro">{t("autoIntro")}</p>
        {jobs.map((j) => (
          <div class="set job">
            <div><b>{j.title}</b><p class="desc">{j.desc}</p></div>
            <a class="btn p" href={`${REPO_URL}/actions/workflows/${j.file}`} target="_blank" rel="noopener">{t("runOnGithub")} ↗</a>
          </div>
        ))}
        <p class="hint"><a href={`${REPO_URL}/actions`} target="_blank" rel="noopener">{t("autoAllRuns")} ↗</a></p>
      </section>

      <section id="p-languages" class="panel" role="tabpanel" aria-labelledby="tab-languages" hidden>
        <h2>{t("languagesOnOff")}</h2>
        <div id="f-langs" class="grid2"></div>
        <p class="hint">{t("needsHindiEnglish")}</p>
        <div class="row"><button type="button" class="btn p f-save">{t("saveSettings")}</button><span class="f-msg" role="status"></span></div>
      </section>

      <section id="p-reports" class="panel" role="tabpanel" aria-labelledby="tab-reports" hidden>
        <h2>{t("reportsTitle")}</h2>
        <p id="r-none" class="empty" hidden>{t("noReports")}</p>
        <div id="r-list"></div>
      </section>
    </div>
    <script type="application/json" id="adm-data" set:html={JSON.stringify(data)} />
  </div>
  <script>import "../../../scripts/admin-page.ts";</script>
  <style>
    .wk-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; margin: 14px 0; }
    .wk-cards div { border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; display: flex; flex-direction: column; gap: 4px; }
    .wk-cards span { font: 400 12.5px var(--body); color: var(--mut); }
    .wk-cards b { font: 700 22px var(--head); color: var(--ink); font-variant-numeric: tabular-nums; }
    .wk-cards b.sm { font-size: 14px; }
    .wk-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 10px; }
    .wk { width: 100%; border-collapse: collapse; font: 400 13.5px var(--body); font-variant-numeric: tabular-nums; }
    .wk th, .wk td { padding: 8px 10px; text-align: left; border-bottom: 1px solid var(--line); white-space: nowrap; }
    .wk thead th { font: 600 12px var(--head); color: var(--mut); background: var(--field); }
    .wk tr.co th { background: var(--accbg); color: var(--ink); font: 700 14px var(--head); }
    .wk tr.co th span { font: 400 12.5px var(--body); color: var(--ink2); }
    .wk td small { display: block; color: var(--mut); font-size: 11.5px; }
    .wk tr.idle td { color: var(--mut); }
    .wk .bar { display: inline-block; width: 60px; height: 6px; margin-right: 8px; vertical-align: middle; background: var(--line); border-radius: 3px; overflow: hidden; }
    .wk .bar i { display: block; height: 100%; background: var(--acc); }
    .wk-list { margin: 6px 0 14px; padding-left: 18px; font: 400 13.5px var(--body); }
    .wk-list li { margin: 3px 0; } .wk-list small { color: var(--mut); }
  </style>
</Base>
